# Ushbu faylni .env nomiga ko'chiring va o'z qiymatlaringizni kiriting:
#   cp .env.example .env

# Flask maxfiy kaliti (majburiy, production uchun kerak)
# Yaratish: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Development rejimida true qiling, production'da false
DEBUG=false

# Cookie faqat HTTPS orqali yuborilishi kerakmi (production'da true bo'lsin)
SESSION_COOKIE_SECURE=true

# Admin panel login ma'lumotlari
ADMIN_USERNAME=admin
# Parol hash'ini olish uchun make_hash.py skriptidan foydalaning
ADMIN_PASSWORD_HASH=

# Ma'lumotlar bazasi fayli yo'li
DB_PATH=articles.db

# Kontakt / ijtimoiy tarmoq havolalari
CONTACT_EMAIL=
CONTACT_TELEGRAM=
CONTACT_LINKEDIN=
CONTACT_GITHUB=
TELEGRAM_CHANNEL=
